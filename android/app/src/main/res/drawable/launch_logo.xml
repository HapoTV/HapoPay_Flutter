<?xml version="1.0" encoding="utf-8"?>
<!-- HapoPay emblem for the launch screen. Mirrors _HapoPayLogoPainter in
     lib/shared/widgets/hapo_pay_logo.dart at the size the Flutter splash
     draws it (92dp). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="92dp"
    android:height="92dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <!-- Outer ring -->
    <path
        android:pathData="M3,50a47,47 0 1 0 94,0a47,47 0 1 0 -94,0z"
        android:strokeWidth="4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="100"
                android:endY="100"
                android:startColor="#FF7C4DFF"
                android:endColor="#FF00D4A1" />
        </aapt:attr>
    </path>
    <!-- Disc -->
    <path android:pathData="M9,50a41,41 0 1 0 82,0a41,41 0 1 0 -82,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="9"
                android:startY="9"
                android:endX="91"
                android:endY="91"
                android:startColor="#FF7C4DFF"
                android:endColor="#FF00D4A1" />
        </aapt:attr>
    </path>
    <!-- "H": left pillar, right pillar, crossbar -->
    <path
        android:fillColor="#F5FFFFFF"
        android:pathData="M29,29.7h4.5a4,4 0 0 1 4,4v32.6a4,4 0 0 1 -4,4h-4.5a4,4 0 0 1 -4,-4v-32.6a4,4 0 0 1 4,-4z" />
    <path
        android:fillColor="#F5FFFFFF"
        android:pathData="M66.5,29.7h4.5a4,4 0 0 1 4,4v32.6a4,4 0 0 1 -4,4h-4.5a4,4 0 0 1 -4,-4v-32.6a4,4 0 0 1 4,-4z" />
    <path
        android:fillColor="#F5FFFFFF"
        android:pathData="M29,44.5h42a4,4 0 0 1 4,4v3a4,4 0 0 1 -4,4h-42a4,4 0 0 1 -4,-4v-3a4,4 0 0 1 4,-4z" />
    <!-- Accent dot -->
    <path
        android:fillColor="#E600D4A1"
        android:pathData="M78.3,20.3a4.5,4.5 0 1 0 9,0a4.5,4.5 0 1 0 -9,0z" />
</vector>

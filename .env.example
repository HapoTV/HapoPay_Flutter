# Injected at compile time with: flutter run --dart-define-from-file=.env.dev
# Do not wrap values in quotes. Copy to .env.dev / .env.prod (gitignored).

# Supabase is optional. Leave empty to skip Supabase.initialize (JWT-only).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Django REST API. Android emulator → host loopback is 10.0.2.2 (not localhost).
# Ignored when USE_MOCK_API=true, but the key must still be present.
API_BASE_URL=http://10.0.2.2:8000/api

# true = in-memory MockInterceptor (no Django). Must be false for release / prod.
USE_MOCK_API=false
